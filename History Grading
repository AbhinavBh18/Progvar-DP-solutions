/*
    state:  
            find the lcs of the ith line with the first line
            dp[i][j]= max common length at idx i and j of ith and first line.
    
    transition;
            if(elements match) dp[i][j]=dp[i-1][j-1]+1;
            else dp[i][j]=max(dp[i-1][j], dp[i][j-1]);
    
    basecase:
    
    othercase:


*/
void solve() {
    int n;
    cin >> n;
    vi temp(n), a(n);
    input(temp,n);
    int ctr=0;
    for(int i=1;i<=n;i++){
        a[temp[i-1]-1]=i-1;
    }
    cin.ignore();
    string line;
    
    while (getline(cin, line)) {
        stringstream ss(line);
        vi v(n);
        int x;
        vi temp;
        while (ss >> x) {
            temp.push_back(x);
        }
        for(int i=1;i<=n;i++){
            v[temp[i-1]-1]=i-1;
        }
        
        vector<vi> dp(n+1, vi(n+1,0));
        for(int i=1;i<=n;i++){
            for(int j=1;j<=n;j++){
                if(a[i-1]==v[j-1]){
                    dp[i][j]=dp[i-1][j-1]+1;
                }else{
                    dp[i][j]=max(dp[i-1][j], dp[i][j-1]);
                }
            }
        }
        cout<<dp[n][n]<<"\n";
    }

}

signed main() {
    ios::sync_with_stdio(0);
