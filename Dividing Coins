/*


    state :- dp[i][j] : possible to have sum j till index i.
    
    
    
    transition :-
        if(arr[i-1] <=j){
            dp[i][j] = dp[i-1][j] || dp[i-1][j-arr[i-1]];
        }else {
            dp[i][j]= dp[i-1][j];
        }
    
    
    base case :-    dp[i][0]= true;
                    means at any index sum=0 is possible.
    
    
    
    anyother condition :-
    
    
    
*/
void solve() {
    int n;
    cin >> n;
    vi a(n);
    input(a,n);
    int sum=0;
    for(int it:a)sum+=it;
    int req = (sum+1)/2;
    vector<vector<bool>> dp(n+1, vector<bool>(req+1,false));
    for(int i=0;i<=n;i++){
        dp[i][0]=true;
    }
    for(int i=1;i<=n;i++){
        for(int j=0;j<=req;j++){
            if(a[i-1] <=j){
                dp[i][j] = dp[i-1][j] || dp[i-1][j-a[i-1]];
            }else {
                dp[i][j]= dp[i-1][j];
            }
        }
    }
    int diff=INF;
    int s2 = sum/2;
    for(int i=0;i<=sum/2;i++){
        if(dp[n][i]){
            diff = min(sum-i-i, diff);
        }
    }
    cout<<diff<<"\n";
    
}

signed main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    int tc = 1;
    cin >> tc;
    for (int t = 1; t <= tc; t++) {
        solve();
    }
    return 0;
}
